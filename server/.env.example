# --- App / Server ---
NODE_ENV=development
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/experiencecurator_dev
# Optional: if you prefer separate fields instead of DATABASE_URL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=experiencecurator_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Embeddings / LLM ---
# Keep these SERVER-ONLY. Never expose to the browser.
OPENAI_API_KEY=your_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Storage (local for dev) ---
STORAGE_DIR=./storage

# --- Observability ---
LOG_LEVEL=info
# Used to correlate logs/requests; you can generate a random UUID for local dev
TRACE_SALT=dev-only-change-me

# --- Limits / Safety ---
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.txt,.md,.docx
TOP_K=8

